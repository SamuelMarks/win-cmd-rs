{
  "abi-return-struct-as-int": true,
  "arch": "x86",
  "archive-format": "coff",
  "binary-format": "coff",
  "cpu": "i586",
  "crt-objects-fallback": "false",
  "data-layout": "e-m:x-p:32:32-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:32-n8:16:32-a:0:32-S32",
  "disable-redzone": true,
  "eh-frame-header": false,
  "emit-debug-gdb-scripts": false,
  "env": "",
  "exe-suffix": ".exe",
  "features": "+soft-float,-mmx,-sse",
  "function-sections": false,
  "is-like-windows": true,
  "linker": "stub/djgpp-linker.sh",
  "linker-flavor": "gnu-cc",
  "llvm-target": "i586-pc-windows-gnu",
  "max-atomic-width": 64,
  "metadata": {
    "description": "32-bit Protected-Mode MS-DOS (DJGPP + CWSDPMI)",
    "host_tools": false,
    "std": false,
    "tier": 3
  },
  "no-default-libraries": false,
  "os": "uefi",
  "panic-strategy": "abort",
  "relocation-model": "static",
  "rustc-abi": "softfloat",
  "singlethread": true,
  "stack-probes": {
    "kind": "none"
  },
  "target-c-int-width": 32,
  "target-pointer-width": 32,
  "vendor": "pc"
}
