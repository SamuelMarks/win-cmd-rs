# ==============================================================================
# Default Behavior & Line Endings
# ==============================================================================
# Auto-detect text files and normalize line endings to LF in the repository
* text=auto eol=lf

# ==============================================================================
# Rust Source & Cargo Configuration
# ==============================================================================
*.rs      text eol=lf diff=rust
*.toml    text eol=lf diff=toml
Cargo.lock text eol=lf -diff linguist-generated=true

# ==============================================================================
# Windows Batch & CMD Scripts (Critical for win-cmd-rs)
# ==============================================================================
# cmd.exe relies on byte offsets and CRLF line endings for label seeking,
# self-modifying batch scripts, and phase1 parser mechanics.
*.bat     text eol=crlf linguist-language=Batchfile
*.cmd     text eol=crlf linguist-language=Batchfile
*.btm     text eol=crlf linguist-language=Batchfile

# Explicit LF or binary test fixtures (if testing mixed/malformed line endings)
tests/fixtures/**/*.lf.bat   text eol=lf
tests/fixtures/**/*.lf.cmd   text eol=lf
tests/fixtures/**/*.raw.bat  -text
tests/fixtures/**/*.raw.cmd  -text
tests/fixtures/**/*.bin      binary

